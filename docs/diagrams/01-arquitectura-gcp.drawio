:12px;color:#5F6368"&gt;Sesiones, trabajos y decisiones&lt;/span&gt;' style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=62;spacingRight=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="580" y="350" width="280" height="80" as="geometry"/></mxCell><mxCell id="c20" value="" style="shape=image;image=data:image/svg+xml,;aspect=fixed;imageAspect=0;" vertex="1" parent="1"><mxGeometry x="592" y="369.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="c21" value='&lt;b style="font-size:14px;color:#202124"&gt;Cloud Storage&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#5F6368"&gt;Imágenes, máscaras y pesos LoRA&lt;/span&gt;' style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=62;spacingRight=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="900" y="350" width="280" height="80" as="geometry"/></mxCell><mxCell id="c22" value="" style="shape=image;image=data:image/svg+xml,;aspect=fixed;imageAspect=0;" vertex="1" parent="1"><mxGeometry x="912" y="369.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="c23" value='&lt;b style="font-size:14px;color:#202124"&gt;Vertex AI&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#5F6368"&gt;Gemini&lt;/span&gt;' style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DADCE0;align=left;spacingLeft=62;spacingRight=6;fontFamily=Helvetica;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="210" y="470" width="270" height="70" as="geometry"/></mxCell><mxCell id="c24" value="" style="shape=image;image=data:image/svg+xml,;aspect=fixed;imageAspect=0;" vertex="1" parent="1"><mxGeometry x="222" y="484.0" width="42" height="42" as="geometry"/></mxCell><mxCell id="c25" value='&lt;span style="font-size:12px;color:#202124"&gt;Artifact Registry&lt;/span&gt;' style="rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#DADCE0;verticalAlign=bottom;spacingBottom=6;fontFamil