y"><Array as="points"><mxPoint x="530" y="198"/><mxPoint x="530" y="285"/><mxPoint x="984" y="285"/></Array></mxGeometry></mxCell><mxCell id="c43" value="⑥" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1A73E8;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="⑦" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1A73E8;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="901" y="265"/><mxPoint x="720" y="265"/></Array></mxGeometry></mxCell><mxCell id="c45" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1A73E8;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="⑨" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1A73E8;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.94;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="540" y="385"/><mxPoint x="540" y="406"/></Array></mxGeometry></mxCell><mxCell id="c47" value="⑩" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#1A73E8;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="Ⓐ Publica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;endArrow=block;endFill=1;strokeColor=#5F6368;fontFamily=Helvetica;fontSize=12;fontColor=#1F2933;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c36" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="① La persona accede con autenticación; no hay despliegue público por defecto.&lt;br&gt;② La API guarda la foto en Cloud Storage y la sesión en Firestore.&lt;br&gt;③ El worker GPU segmenta; la máscara se guarda como artefacto.&lt;br&gt;④ La API bloquea la máscara y encola la generación; responde 202.&lt;br&gt;⑤ Cloud Tasks invoca al worker con identidad IAM y reintentos idempotentes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#3C4043;" vertex="1" parent="1"><mxGeometry x="170" y="675" width="525" height="110" as="geometry"/></mxCell><mxCell id="c51" value="⑥ El worker lee imagen, máscara y pesos, y guarda los cinco resultados.&lt;br&gt;⑦ Solo con el lote completo registra las variaciones y READY_FOR_REVIEW.&lt;br&gt;⑧ La API muestra los resultados y registra las cinco decisiones.&lt;br&gt;⑨ El agente lee las decisiones mediante herramientas de solo lectura.&lt;br&gt;⑩ Gemini redacta el resumen estructurado; Python lo verifica y lo presenta." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#3C4043;" vertex="1" parent="1"><mxGeometry x="705" y="675" width="525" height="110" as="geometry"/></mxCell><mxCell id="c52" value="&lt;b&gt;Continua:&lt;/b&gt; llamada síncrona&lt;br&gt;&lt;b&gt;Discontinua azul:&lt;/b&gt; asíncrona&lt;br&gt;&lt;b&gt;Discontinua gris:&lt;/b&gt; offline, fuera de GCP&lt;br&gt;Ⓐ Colab publica el LoRA versionado&lt;br&gt;&lt;b&gt;Identidades:&lt;/b&gt; una por servicio, permisos mínimos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#3C4043;" vertex="1" parent="1"><mxGeometry x="1240" y="675" width="300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>