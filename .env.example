# Plantilla: copiar a .env (que Git ignora) y completar ahí. Nunca poner valores reales aquí.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
SQLITE_PATH=./data/productshot.sqlite3
ASSET_ROOT=./data/assets
MAX_UPLOAD_MB=10

# Piezas intercambiables (ADR-009, backend/productshot/composition.py)
# Valores: GENERATION_BACKEND mock | remote; SUMMARY_BACKEND deterministic | gemini; JOB_RUNNER thread | inline
GENERATION_BACKEND=mock
SEGMENTATION_BACKEND=mock
SUMMARY_BACKEND=deterministic
JOB_RUNNER=thread

# Worker de generación (GENERATION_BACKEND=remote): Modal, Cloud Run o la laptop, mismo contrato HTTP.
# GENERATION_WORKER_URL=http://127.0.0.1:8001
# GENERATION_WORKER_TOKEN=
# WORKER_HOST=127.0.0.1
# WORKER_PORT=8001

# Agente de resumen (SUMMARY_BACKEND=gemini). Clave de AI Studio; los comentarios van en su propia línea.
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL_ID=gemini-3.5-flash-lite

# Reservado para fases futuras (documentar antes de activar).
# HF_TOKEN=
# GCP_PROJECT_ID=
# GCP_REGION=
# GCS_BUCKET=
# BASE_MODEL_ID=
# BASE_MODEL_REVISION=
# LORA_ADAPTER_URI=
