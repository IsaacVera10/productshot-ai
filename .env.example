# Plantilla: no contiene secretos ni configura servicios remotos en el primer hito.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
SQLITE_PATH=./data/productshot.sqlite3
ASSET_ROOT=./data/assets
GENERATION_BACKEND=mock
SEGMENTATION_BACKEND=mock
SUMMARY_BACKEND=deterministic
MAX_UPLOAD_MB=10
# Reservado para fases futuras (documentar antes de activar). Ver ADR-009.
# GEMINI_API_KEY=            # AI Studio; nunca versionar el valor real
# GENERATION_WORKER_URL=     # worker con GPU (Modal, Cloud Run o laptop), mismo contrato HTTP
# HF_TOKEN=                  # lectura de los repositorios privados del LoRA y del dataset
# GCP_PROJECT_ID=
# GCP_REGION=
# GCS_BUCKET=
# GEMINI_MODEL_ID=
# BASE_MODEL_ID=
# BASE_MODEL_REVISION=
# LORA_ADAPTER_URI=
