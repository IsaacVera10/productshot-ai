# Plantilla: copiar a .env (que Git ignora) y completar ahí. Nunca poner valores reales aquí.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
SQLITE_PATH=./data/productshot.sqlite3
ASSET_ROOT=./data/assets
MAX_UPLOAD_MB=10
# Retención (G11): cada cadena de rondas se borra con sus fotos a estas horas de la primera ronda (0 = nunca).
SESSION_RETENTION_HOURS=24

# Piezas intercambiables (ADR-009, backend/productshot/composition.py)
# Valores: GENERATION_BACKEND y SEGMENTATION_BACKEND mock | remote; SUMMARY_BACKEND deterministic | gemini; JOB_RUNNER thread | inline
GENERATION_BACKEND=mock
SEGMENTATION_BACKEND=mock
# G2, G3 y G15 (revisión de la foto). Con GENERATION_BACKEND=remote tiene que ser remote: la API no arranca si no.
SCREENING_BACKEND=mock
SUMMARY_BACKEND=deterministic
JOB_RUNNER=thread

# Worker de generación (GENERATION_BACKEND=remote): Modal, Cloud Run o la laptop, mismo contrato HTTP.
# GENERATION_WORKER_URL=http://127.0.0.1:8001
# GENERATION_WORKER_TOKEN=
# Un worker por modo: GENERATION_WORKER_URL sirve el intermedio (y segmenta y revisa fotos);
# con ADVANCED_WORKER_URL las sesiones avanzadas van al worker del LoRA. Sin ella, el modo avanzado
# responde «todavía no está disponible».
# ADVANCED_WORKER_URL=
# ADVANCED_WORKER_TOKEN=
# WORKER_HOST=127.0.0.1
# WORKER_PORT=8001

# Agente de resumen (SUMMARY_BACKEND=gemini). Clave de AI Studio; los comentarios van en su propia línea.
# GEMINI_API_KEY=
# GEMINI_MODEL_ID=gemini-3.5-flash
# GEMINI_FALLBACK_MODEL_ID=gemini-3.5-flash-lite

# Reservado para fases futuras (documentar antes de activar).
# HF_TOKEN=
# GCP_PROJECT_ID=
# GCP_REGION=
# GCS_BUCKET=
# BASE_MODEL_ID=
# BASE_MODEL_REVISION=
# LORA_ADAPTER_URI=
